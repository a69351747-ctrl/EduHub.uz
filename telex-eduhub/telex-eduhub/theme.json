{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1280px"
		},
		"color": {
			"palette": [
				{
					"slug": "background",
					"color": "#FDF6EC",
					"name": "Background (Cream)"
				},
				{
					"slug": "text",
					"color": "#1C1C1E",
					"name": "Text (Near-Black)"
				},
				{
					"slug": "muted",
					"color": "#5C5C60",
					"name": "Muted Text"
				},
				{
					"slug": "surface",
					"color": "#F7F1E6",
					"name": "Surface (Card)"
				},
				{
					"slug": "primary",
					"color": "#2D7A4F",
					"name": "Primary (Garden Green)"
				},
				{
					"slug": "primary-dark",
					"color": "#1B5E3A",
					"name": "Primary Dark (Forest)"
				},
				{
					"slug": "secondary",
					"color": "#F5A623",
					"name": "Secondary (Amber)"
				},
				{
					"slug": "tertiary",
					"color": "#7C4DFF",
					"name": "Tertiary (Violet)"
				},
				{
					"slug": "accent-orange",
					"color": "#FF6B35",
					"name": "Accent Orange"
				},
				{
					"slug": "accent-red",
					"color": "#E53935",
					"name": "Accent Red"
				},
				{
					"slug": "success",
					"color": "#34C759",
					"name": "Success Green"
				},
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "White"
				},
				{
					"slug": "sage-mist",
					"color": "#E8F5E2",
					"name": "Sage Mist"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "'Nunito', sans-serif",
					"slug": "heading",
					"name": "Nunito (Headings)"
				},
				{
					"fontFamily": "'Nunito Sans', sans-serif",
					"slug": "body",
					"name": "Nunito Sans (Body)"
				},
				{
					"fontFamily": "'JetBrains Mono', monospace",
					"slug": "mono",
					"name": "JetBrains Mono"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "clamp(0.8125rem, 0.75rem + 0.25vw, 0.875rem)",
					"name": "Small",
					"fluid": false
				},
				{
					"slug": "medium",
					"size": "clamp(0.9375rem, 0.875rem + 0.3vw, 1.0625rem)",
					"name": "Medium",
					"fluid": false
				},
				{
					"slug": "large",
					"size": "clamp(1.125rem, 1rem + 0.5vw, 1.25rem)",
					"name": "Large",
					"fluid": false
				},
				{
					"slug": "x-large",
					"size": "clamp(1.375rem, 1.125rem + 1vw, 1.75rem)",
					"name": "X-Large",
					"fluid": false
				},
				{
					"slug": "xx-large",
					"size": "clamp(1.75rem, 1.25rem + 2vw, 2.75rem)",
					"name": "XX-Large",
					"fluid": false
				},
				{
					"slug": "display",
					"size": "clamp(2.5rem, 1.75rem + 3vw, 4.5rem)",
					"name": "Display",
					"fluid": false
				}
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{
					"slug": "10",
					"size": "0.25rem",
					"name": "3XS"
				},
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "2XS"
				},
				{
					"slug": "30",
					"size": "1rem",
					"name": "XS"
				},
				{
					"slug": "40",
					"size": "1.5rem",
					"name": "S"
				},
				{
					"slug": "50",
					"size": "2.5rem",
					"name": "M"
				},
				{
					"slug": "60",
					"size": "4rem",
					"name": "L"
				},
				{
					"slug": "70",
					"size": "5.5rem",
					"name": "XL"
				},
				{
					"slug": "80",
					"size": "7rem",
					"name": "2XL"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|text"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65",
			"fontWeight": "400"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "clamp(1.5rem, 5vw, 4rem)",
				"right": "clamp(1.5rem, 5vw, 4rem)"
			},
			"blockGap": "var:preset|spacing|40"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "800",
					"lineHeight": "1.15"
				},
				"color": {
					"text": "var:preset|color|text"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|display",
					"fontWeight": "900",
					"letterSpacing": "-0.03em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"fontWeight": "800",
					"letterSpacing": "-0.02em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "700"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|primary-dark"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontFamily": "var:preset|font-family|body"
				},
				"color": {
					"text": "var:preset|color|muted"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600"
				},
				"color": {
					"text": "var:preset|color|text"
				},
				"spacing": {
					"blockGap": "var:preset|spacing|30"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "900",
					"letterSpacing": "-0.5px"
				},
				"color": {
					"text": "var:preset|color|primary"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|primary"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|primary-dark"
							}
						}
					}
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400"
				},
				"color": {
					"text": "var:preset|color|muted"
				}
			},
			"core/button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|white"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|primary-dark",
						"text": "var:preset|color|white"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "800",
					"fontSize": "var:preset|font-size|medium"
				},
				"border": {
					"radius": "100px"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|20",
						"bottom": "var:preset|spacing|20",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40"
					}
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "var:preset|spacing|30"
				}
			},
			"core/post-template": {
				"spacing": {
					"blockGap": "var:preset|spacing|40"
				}
			},
			"core/query": {
				"spacing": {
					"blockGap": "var:preset|spacing|50"
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": "var:preset|spacing|40"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontSize": "var:preset|font-size|xx-large",
					"fontWeight": "800"
				},
				"color": {
					"text": "var:preset|color|text"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|text"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|primary"
							}
						}
					}
				}
			},
			"core/post-date": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600"
				},
				"color": {
					"text": "var:preset|color|muted"
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.6"
				},
				"color": {
					"text": "var:preset|color|muted"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontSize": "var:preset|font-size|large",
					"fontStyle": "normal",
					"fontWeight": "700"
				},
				"color": {
					"text": "var:preset|color|text"
				},
				"border": {
					"left": {
						"color": "var:preset|color|primary",
						"width": "4px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|40"
					}
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small"
				},
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|text"
				},
				"border": {
					"radius": "12px"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|surface"
				},
				"border": {
					"color": "var:preset|color|surface",
					"width": "1px"
				}
			},
			"core/image": {
				"border": {
					"radius": "20px"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "800",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "var:preset|color|primary"
				},
				"border": {
					"top": {
						"color": "var:preset|color|primary",
						"width": "4px",
						"style": "solid"
					},
					"bottom": {
						"color": "var:preset|color|primary",
						"width": "4px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page (No Title)",
			"postTypes": ["page"]
		},
		{
			"name": "blank",
			"title": "Blank Canvas",
			"postTypes": ["page", "post"]
		}
	]
}